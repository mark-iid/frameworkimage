#!/usr/bin/env bash
# kb3lyb-bootstrap — first-run per-user setup (DESIGN §6/§9.6). Idempotent: safe
# to re-run. Baked into the image (this is the one piece that can't live in the
# dotfiles repo, since it's what clones the dotfiles repo).
#
#   1. clone the private dotfiles repo over HTTPS (git prompts for a token)
#   2. stow every package into $HOME
#   3. install $HOME tooling: Homebrew, its Brewfile, SDKMAN, JetBrains Toolbox
#
# Nothing here needs root. Secrets are never baked (DESIGN §6): the clone
# authenticates interactively.
set -uo pipefail

DOTFILES_REPO="${DOTFILES_REPO:-https://git.mystikos.org/mark/dot-files.git}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

say()  { printf '\033[1;34m>>> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!!! %s\033[0m\n' "$*" >&2; }

# --- 1. dotfiles ---------------------------------------------------------------
if [[ -d "$DOTFILES_DIR/.git" ]]; then
  say "dotfiles present, pulling latest"
  git -C "$DOTFILES_DIR" pull --ff-only || warn "git pull failed; continuing with local copy"
else
  say "cloning dotfiles from $DOTFILES_REPO (git will prompt for credentials)"
  git clone "$DOTFILES_REPO" "$DOTFILES_DIR" || { warn "clone failed — fix auth and re-run"; exit 1; }
fi

# --- 2. stow -------------------------------------------------------------------
if command -v stow >/dev/null; then
  say "stowing dotfiles into $HOME"
  cd "$DOTFILES_DIR"
  for pkg in */; do
    pkg="${pkg%/}"
    [[ "$pkg" == ".git" ]] && continue
    if stow --restow --target="$HOME" "$pkg" 2>&1; then
      echo "    stowed $pkg"
    else
      warn "stow refused '$pkg' — a real file is likely in the way (baked default placed too aggressively? See DESIGN §6)"
    fi
  done
else
  warn "stow not installed; skipping dotfiles link step"
fi

# --- 3. $HOME tooling ----------------------------------------------------------
# Homebrew (Linux) — also the source of the .zshrc plugins. It installs to the
# shared prefix /home/linuxbrew/.linuxbrew, which takes a one-time `sudo` to
# create. The NONINTERACTIVE installer will NOT prompt for that password and
# aborts with a "Need sudo access"/permissions error when sudo isn't already
# authenticated — so prime the sudo credential cache first (you'll be asked once),
# then run the installer non-interactively.
if ! command -v brew >/dev/null && [[ ! -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  say "installing Homebrew (needs your password once, to create /home/linuxbrew)"
  if sudo -v; then
    NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
      || warn "brew install failed"
  else
    warn "brew install skipped: it needs sudo to create /home/linuxbrew. Fix sudo access, then re-run kb3lyb-bootstrap."
  fi
fi
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  if [[ -f "$DOTFILES_DIR/Brewfile" ]]; then
    say "brew bundle from dotfiles Brewfile"
    brew bundle --file="$DOTFILES_DIR/Brewfile" || warn "some brew formulae failed (non-fatal)"
  fi
fi

# SDKMAN (Java for SailPoint IIQ — DESIGN §2), installs to ~/.sdkman
if [[ ! -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  say "installing SDKMAN"
  curl -fsSL "https://get.sdkman.io?rcupdate=false" | bash || warn "SDKMAN install failed"
fi

# JetBrains Toolbox (self-updating, in $HOME — DESIGN §2). First run installs it
# to ~/.local/share/JetBrains/Toolbox and adds launchers.
if [[ ! -d "$HOME/.local/share/JetBrains/Toolbox" ]]; then
  say "installing JetBrains Toolbox"
  tmp="$(mktemp -d)"
  if curl -fsSL "https://data.services.jetbrains.com/products/download?platform=linux&code=TBA" -o "$tmp/toolbox.tar.gz"; then
    tar -xzf "$tmp/toolbox.tar.gz" -C "$tmp"
    tbx="$(find "$tmp" -maxdepth 2 -name jetbrains-toolbox -type f | head -1)"
    if [[ -n "$tbx" ]]; then
      # Stage the bootstrapper into ~/.local/bin FIRST, then launch it from there.
      # The old code ran it straight out of $tmp and then `rm -rf`'d $tmp right
      # away, deleting the binary mid-self-install — so Toolbox never installed.
      # Copying to a stable, on-PATH location makes the cleanup below safe and
      # leaves a working launcher behind. setsid fully detaches it from this shell.
      mkdir -p "$HOME/.local/bin"
      install -m755 "$tbx" "$HOME/.local/bin/jetbrains-toolbox"
      setsid "$HOME/.local/bin/jetbrains-toolbox" >/dev/null 2>&1 </dev/null &
      say "JetBrains Toolbox launched; complete sign-in from its window (Super+D → JetBrains Toolbox)."
    else
      warn "JetBrains Toolbox binary not found in the downloaded archive"
    fi
  else
    warn "JetBrains Toolbox download failed"
  fi
  rm -rf "$tmp"
fi

# --- 4. login shell ------------------------------------------------------------
# The dotfiles target zsh (.zshrc). Make it the login shell so a fresh user lands
# in zsh — and thus brew + plugins — without a manual chsh. `sudo chsh` lets root
# change the shell without prompting for the account password via PAM; sudo was
# primed above by the brew step, and we re-prime defensively in case brew was
# already installed and that path got skipped. zsh's RPM registers /usr/bin/zsh in
# /etc/shells, so chsh accepts it.
if command -v zsh >/dev/null; then
  zsh_path="$(command -v zsh)"
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"
  if [[ "$current_shell" != "$zsh_path" ]]; then
    say "setting login shell to zsh"
    sudo -v && sudo chsh -s "$zsh_path" "$USER" \
      || warn "could not set login shell to zsh; run manually: chsh -s $zsh_path"
  fi
else
  warn "zsh not installed; leaving login shell unchanged"
fi

# --- 5. desktop appearance -----------------------------------------------------
# Global dark mode. niri has no settings daemon (unlike GNOME/KDE), so nothing
# sets the XDG desktop-portal color-scheme for us — yet GTK4/libadwaita, Firefox,
# Electron and portal-aware Qt apps all read `prefer-dark` from it. gtk-theme
# additionally covers older GTK3 apps that theme directly instead of via the
# portal. This is a per-user dconf setting (lives in $HOME), so it can't be baked
# into the image; apply it here. Idempotent — re-running just re-sets the value.
if command -v gsettings >/dev/null; then
  say "setting global dark mode (portal color-scheme + GTK theme)"
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark || warn "could not set color-scheme (no dbus session? run inside the niri session)"
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark    || warn "could not set gtk-theme"
fi

say "bootstrap complete. Open a new shell (zsh) to pick up the environment."
