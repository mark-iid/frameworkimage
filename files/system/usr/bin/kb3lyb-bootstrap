#!/usr/bin/env bash
# kb3lyb-bootstrap — first-run per-user setup (DESIGN §6/§9.6). Idempotent: safe
# to re-run. Baked into the image (this is the one piece that can't live in the
# dotfiles repo, since it's what clones the dotfiles repo).
#
#   1. clone the private dotfiles repo over HTTPS (git prompts for a token)
#   2. stow every package into $HOME
#   3. install $HOME tooling: Homebrew, its Brewfile, SDKMAN, JetBrains Toolbox
#
# Nothing here needs root. Secrets are never baked (DESIGN §6): the clone
# authenticates interactively.
set -uo pipefail

DOTFILES_REPO="${DOTFILES_REPO:-https://git.mystikos.org/mark/dot-files.git}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

say()  { printf '\033[1;34m>>> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!!! %s\033[0m\n' "$*" >&2; }

# --- 1. dotfiles ---------------------------------------------------------------
if [[ -d "$DOTFILES_DIR/.git" ]]; then
  say "dotfiles present, pulling latest"
  git -C "$DOTFILES_DIR" pull --ff-only || warn "git pull failed; continuing with local copy"
else
  say "cloning dotfiles from $DOTFILES_REPO (git will prompt for credentials)"
  git clone "$DOTFILES_REPO" "$DOTFILES_DIR" || { warn "clone failed — fix auth and re-run"; exit 1; }
fi

# --- 2. stow -------------------------------------------------------------------
if command -v stow >/dev/null; then
  say "stowing dotfiles into $HOME"
  cd "$DOTFILES_DIR"
  for pkg in */; do
    pkg="${pkg%/}"
    [[ "$pkg" == ".git" ]] && continue
    if stow --restow --target="$HOME" "$pkg" 2>&1; then
      echo "    stowed $pkg"
    else
      warn "stow refused '$pkg' — a real file is likely in the way (baked default placed too aggressively? See DESIGN §6)"
    fi
  done
else
  warn "stow not installed; skipping dotfiles link step"
fi

# --- 3. $HOME tooling ----------------------------------------------------------
# Homebrew (Linux) — also the source of the .zshrc plugins.
if ! command -v brew >/dev/null && [[ ! -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  say "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || warn "brew install failed"
fi
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  if [[ -f "$DOTFILES_DIR/Brewfile" ]]; then
    say "brew bundle from dotfiles Brewfile"
    brew bundle --file="$DOTFILES_DIR/Brewfile" || warn "some brew formulae failed (non-fatal)"
  fi
fi

# SDKMAN (Java for SailPoint IIQ — DESIGN §2), installs to ~/.sdkman
if [[ ! -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  say "installing SDKMAN"
  curl -fsSL "https://get.sdkman.io?rcupdate=false" | bash || warn "SDKMAN install failed"
fi

# JetBrains Toolbox (self-updating, in $HOME — DESIGN §2). First run installs it
# to ~/.local/share/JetBrains/Toolbox and adds launchers.
if [[ ! -d "$HOME/.local/share/JetBrains/Toolbox" ]]; then
  say "installing JetBrains Toolbox"
  tmp="$(mktemp -d)"
  if curl -fsSL "https://data.services.jetbrains.com/products/download?platform=linux&code=TBA" -o "$tmp/toolbox.tar.gz"; then
    tar -xzf "$tmp/toolbox.tar.gz" -C "$tmp"
    tbx="$(find "$tmp" -maxdepth 2 -name jetbrains-toolbox -type f | head -1)"
    [[ -n "$tbx" ]] && "$tbx" >/dev/null 2>&1 & disown
    say "JetBrains Toolbox launched to self-install; finish it from the tray"
  else
    warn "JetBrains Toolbox download failed"
  fi
  rm -rf "$tmp"
fi

say "bootstrap complete. Open a new shell (zsh) to pick up the environment."
