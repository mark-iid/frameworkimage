#!/usr/bin/env bash
# kb3lyb-bootstrap — first-run per-user setup (DESIGN §6/§9.6). Idempotent: safe
# to re-run. Baked into the image (this is the one piece that can't live in the
# dotfiles repo, since it's what clones the dotfiles repo).
#
#   1. clone the public dotfiles repo over HTTPS (anonymous — no token needed);
#      pushes are pointed at SSH, for once ~/.ssh is restored
#   2. stow every package into $HOME
#   3. install $HOME tooling: Homebrew, its Brewfile, SDKMAN, JetBrains Toolbox
#
# Nothing here needs root, and nothing is secret: the dotfiles repo is public
# (secrets never live in it — see its .gitignore), so the clone is anonymous. On
# GitHub for availability during disaster recovery (a self-hosted git could be the
# very thing you're recovering). Override DOTFILES_REPO to use a fork/mirror.
set -uo pipefail

DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/mark-iid/dotfiles.git}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

say()  { printf '\033[1;34m>>> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!!! %s\033[0m\n' "$*" >&2; }

# --- 1. dotfiles ---------------------------------------------------------------
if [[ -d "$DOTFILES_DIR/.git" ]]; then
  say "dotfiles present, pulling latest"
  git -C "$DOTFILES_DIR" pull --ff-only || warn "git pull failed; continuing with local copy"
else
  say "cloning dotfiles from $DOTFILES_REPO (public — no auth needed)"
  git clone "$DOTFILES_REPO" "$DOTFILES_DIR" || { warn "clone failed — check network and re-run"; exit 1; }
fi

# Push over SSH, fetch over anonymous HTTPS. GitHub takes no password for HTTPS
# pushes, and no credential helper is set up this early, so with only the HTTPS URL the
# first push after a reinstall fails with "could not read Username for
# 'https://github.com'" (2026-10-11). Setting only the push URL keeps `git pull`,
# and so a re-run of this script, working before ~/.ssh is restored. Applied
# to an existing clone too, and only when origin is the GitHub HTTPS form.
origin_url="$(git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null)"
if [[ "$origin_url" =~ ^https://github\.com/(.+)$ ]]; then
  git -C "$DOTFILES_DIR" remote set-url --push origin "git@github.com:${BASH_REMATCH[1]}"
fi

# Activate the repo's secret-blocking pre-commit hook. core.hooksPath is local git
# config (not carried by clone), so set it here — this keeps credentials from ever
# being committed into the public dotfiles repo.
if [[ -x "$DOTFILES_DIR/.githooks/pre-commit" ]]; then
  git -C "$DOTFILES_DIR" config core.hooksPath .githooks
fi

# --- 2. stow -------------------------------------------------------------------
if command -v stow >/dev/null; then
  say "stowing dotfiles into $HOME"
  # ~/.local/bin must exist as a REAL directory before stowing. Only the `bin`
  # package provides it, so otherwise stow "folds" it: ~/.local/bin becomes a
  # symlink to ~/dotfiles/bin/.local/bin, and everything an installer drops there
  # lands inside the public dotfiles repo. On 2026-10-11 that was jetbrains-toolbox
  # and the voice toolbox's pip launchers, 16 untracked files. With the directory
  # already there, stow links the scripts individually. Done here rather than with
  # --no-folding, which would also unfold ~/.config/* and change where new
  # config files land.
  mkdir -p "$HOME/.local/bin"
  # A conflicting regular file is MOVED ASIDE, not worked around. On a fresh
  # install the first thing stow meets is Fedora's /etc/skel/.zshrc, copied into
  # every new account by useradd, and stow refuses a package wholesale when any
  # one of its targets is a real file. That took out the entire `zsh` package on
  # 2026-11-13: ~/.zshrc stayed the skel default, so `brew shellenv` never ran,
  # /home/linuxbrew/.linuxbrew/bin never reached PATH, and ~60 installed brew
  # programs — aerc, nvim, tmux, starship, atuin, zellij — looked uninstalled.
  # kb3lyb-doctor reported all of it, as nine separate "deadconfig" findings
  # plus "brew not installed", none of which named the cause. Thunar's
  # first-run uca.xml took out that package the same way.
  #
  # The refusal was warned about and nothing more, which is the wrong default
  # here: the file in the way is a distro default or a program's first-run
  # scratch copy, never something worth keeping over the tracked version. So
  # collect the blockers from a dry run, move them under ~/.local/state/kb3lyb/
  # pre-stow/ (a move, so nothing is lost and the path is printed), and retry
  # once. --adopt would be the obvious shortcut and is exactly wrong: it pulls
  # the skel file INTO the repo, overwriting the tracked .zshrc with Fedora's.
  #
  # Stow each package by absolute --dir instead of cd'ing in: an unguarded `cd` that
  # silently failed would stow from the wrong cwd into $HOME. The */ glob skips .git.
  prestow="$HOME/.local/state/kb3lyb/pre-stow"
  for pkg in "$DOTFILES_DIR"/*/; do
    pkg="$(basename "$pkg")"
    if stow --restow --dir="$DOTFILES_DIR" --target="$HOME" "$pkg" 2>&1; then
      echo "    stowed $pkg"
      continue
    fi
    # Targets stow named as "neither a link nor a directory", i.e. real files.
    # Anything else it refused over (a directory, a symlink elsewhere) is left
    # alone and reported, because those are not the distro-default case.
    mapfile -t blockers < <(
      stow -n --restow --dir="$DOTFILES_DIR" --target="$HOME" "$pkg" 2>&1 \
        | sed -n 's/.*over existing target \(.*\) since neither a link nor a directory.*/\1/p'
    )
    moved=0
    for rel in "${blockers[@]}"; do
      [[ -f "$HOME/$rel" && ! -L "$HOME/$rel" ]] || continue
      mkdir -p "$prestow/$(dirname "$rel")"
      if mv "$HOME/$rel" "$prestow/$rel"; then
        echo "    moved aside ~/$rel -> $prestow/$rel"
        moved=$((moved+1))
      fi
    done
    if (( moved )) && stow --restow --dir="$DOTFILES_DIR" --target="$HOME" "$pkg" 2>&1; then
      echo "    stowed $pkg (after moving $moved default(s) aside)"
    else
      warn "stow refused '$pkg' — something other than a plain default file is in the way (See DESIGN §6)"
    fi
  done
else
  warn "stow not installed; skipping dotfiles link step"
fi

# --- 3. $HOME tooling ----------------------------------------------------------
# Homebrew (Linux) — also the source of the .zshrc plugins. It installs to the
# shared prefix /home/linuxbrew/.linuxbrew, which takes a one-time `sudo` to
# create. The NONINTERACTIVE installer will NOT prompt for that password and
# aborts with a "Need sudo access"/permissions error when sudo isn't already
# authenticated — so prime the sudo credential cache first (you'll be asked once),
# then run the installer non-interactively.
if ! command -v brew >/dev/null && [[ ! -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  say "installing Homebrew (needs your password once, to create /home/linuxbrew)"
  if sudo -v; then
    NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
      || warn "brew install failed"
  else
    warn "brew install skipped: it needs sudo to create /home/linuxbrew. Fix sudo access, then re-run kb3lyb-bootstrap."
  fi
fi
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  if [[ -f "$DOTFILES_DIR/Brewfile" ]]; then
    # Homebrew 7 will not load a formula from a non-official tap until it has
    # been trusted, and the trust lives in ~/.homebrew/trust.json — per-machine
    # state that a wipe destroys. So `brew bundle` refuses that formula on every
    # fresh install, inside its own non-fatal warning, and the result surfaces
    # much later as kb3lyb-doctor reporting "in the Brewfile but not installed"
    # (2026-11-13, charmbracelet/tap/crush, the only tapped formula here).
    #
    # The list is derived from the Brewfile rather than hardcoded, the way
    # kb3lyb-restore builds its exclude list from `git ls-files`: adding another
    # tapped formula later needs no change here, and a hand-maintained copy
    # would drift silently.
    #
    # --formula, never --tap. Trusting the tap would also cover whatever is
    # added to that tap in future; trusting the formula covers exactly what is
    # declared. The Brewfile is the trust boundary, which is the point: a
    # formula gets trusted here only by having been written into a file in the
    # dotfiles repo, where the decision is reviewable and in git history.
    if brew trust --help >/dev/null 2>&1; then
      while read -r f; do
        [[ -n "$f" ]] || continue
        if brew trust --formula "$f" >/dev/null 2>&1; then
          echo "    trusted $f"
        else
          warn "could not trust '$f' — run: brew trust --formula $f"
        fi
      done < <(grep -oE '^brew "[^"]+/[^"]+/[^"]+"' "$DOTFILES_DIR/Brewfile" \
                 | sed 's/^brew "//; s/"$//')
    fi
    say "brew bundle from dotfiles Brewfile"
    brew bundle --file="$DOTFILES_DIR/Brewfile" || warn "some brew formulae failed (non-fatal)"
  fi
  # rbw (Bitwarden CLI, powers the Mod+P/Mod+O pickers) — settings only, no secrets.
  # base_url/email aren't sensitive (the URL is already public via TLS cert
  # transparency). A one-time `rbw login` (master password + TOTP) is still needed;
  # the agent handles unlocks after that.
  if command -v rbw >/dev/null; then
    say "configuring rbw (still need a one-time 'rbw login')"
    rbw config set base_url https://pw.mystikos.org
    rbw config set email mark@mystikos.org
    rbw config set pinentry pinentry-gnome3
    rbw config set lock_timeout 3600
  fi
fi

# SDKMAN (Java for SailPoint IIQ — DESIGN §2), installs to ~/.sdkman
if [[ ! -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  say "installing SDKMAN"
  curl -fsSL "https://get.sdkman.io?rcupdate=false" | bash || warn "SDKMAN install failed"
fi

# ...and a JDK, which until 2026-11-11 this script did NOT do. SDKMAN was
# installed and left empty, so the machine had no `javac` at all — found when
# nvim's Mason could not build java-debug-adapter. "Install the version manager"
# is not the same as "install the thing", and an empty ~/.sdkman looks fine.
#
# Three majors because the poms in ~/src disagree: 1.8, 17 and 25 all appear.
#   17  default — SailPoint IIQ 8.x is supported on 8/11/17, and IIQ is the
#       stated reason SDKMAN is here at all
#   21  current LTS, for everything that is not IIQ
#   8   the legacy 1.8 projects
#
# Versions are RESOLVED, not pinned: SDKMAN drops old patch builds from its
# index, so a hardcoded 17.0.21.0+9-tem would start failing the moment Temurin
# ships the next patch. Takes the newest non-installed build of each major.
# Entirely non-fatal — a failure here must not stop the rest of bootstrap.
if [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  # set +u around the source is REQUIRED, not defensive. This script runs under
  # `set -u` and sdkman-init.sh tests $ZSH_VERSION unguarded, so sourcing it
  # aborts with "ZSH_VERSION: unbound variable" and every sdk call afterwards is
  # a no-op. It fails silently in the sense that matters: the script continues,
  # SDKMAN looks installed, and ~/.sdkman/candidates/java stays empty.
  set +u
  # shellcheck disable=SC1091
  source "$HOME/.sdkman/bin/sdkman-init.sh"
  # `sdk` is a shell FUNCTION and reads this from the shell, so it has to be set
  # here. As a command prefix (`sdkman_auto_answer=false sdk install ...`) it
  # would land in the environment of whatever is being prefixed and the function
  # would never see it — which, with auto_answer left at its default, lets the
  # second and third installs each silently take over as the default JDK.
  export sdkman_auto_answer=false
  for major in 17 21 8; do
    # Anchored on "<major>." — a bare *${major}*-tem glob would let 8 match an
    # 18.x or x.x.8 build and skip the install that was actually wanted.
    if compgen -G "$HOME/.sdkman/candidates/java/${major}.*-tem" >/dev/null; then
      continue   # some build of this major is already here
    fi
    # The identifier is the LAST pipe-separated field of `sdk list java`. Keyed
    # off $NF rather than a column number on purpose: the table is 4 columns
    # wide here and 6 in other sdkman versions, so a fixed index resolves to
    # nothing and the whole loop silently installs no JDK at all. `sdk list` is
    # newest-first, so the first match is the newest build of that major, and
    # index(id, m ".") == 1 anchors it so major 8 cannot match 18.x.
    ident="$(sdk list java 2>/dev/null | awk -F'|' -v m="$major" '
        { id = $NF; gsub(/^[ \t]+|[ \t]+$/, "", id)
          if (id ~ /-tem$/ && index(id, m ".") == 1) { print id; exit } }')"
    if [[ -z "$ident" ]]; then
      warn "no Temurin $major found in the SDKMAN index; skipping"
      continue
    fi
    say "installing JDK $ident"
    yes n | sdk install java "$ident" >/dev/null 2>&1 \
      || warn "could not install java $ident"
  done
  # Set the default LAST and explicitly, so it does not depend on install order.
  default_java="$(compgen -G "$HOME/.sdkman/candidates/java/17.*-tem" | head -1)"
  if [[ -n "$default_java" ]]; then
    sdk default java "$(basename "$default_java")" >/dev/null 2>&1 \
      || warn "could not set the default JDK"
  fi
  set -u
fi

# JetBrains Toolbox (self-updating, in $HOME — DESIGN §2). Since 3.x it ships as a
# BUNDLE (bin/jetbrains-toolbox + bin/lib/), not a single binary, and the binary
# sits at bin/ inside a versioned top dir. So extract the whole tree to a stable
# path (strip the top dir) and run it from there — copying just the binary, or
# `find -maxdepth 2`, silently failed on 3.x and left Toolbox uninstalled.
TBX_HOME="$HOME/.local/share/JetBrains/Toolbox-app"
if [[ ! -x "$TBX_HOME/bin/jetbrains-toolbox" ]]; then
  say "installing JetBrains Toolbox"
  tmp="$(mktemp -d)"
  if curl -fsSL "https://data.services.jetbrains.com/products/download?platform=linux&code=TBA" -o "$tmp/toolbox.tar.gz"; then
    mkdir -p "$TBX_HOME"
    tar -xzf "$tmp/toolbox.tar.gz" -C "$TBX_HOME" --strip-components=1
    if [[ -x "$TBX_HOME/bin/jetbrains-toolbox" ]]; then
      mkdir -p "$HOME/.local/bin"
      ln -sf "$TBX_HOME/bin/jetbrains-toolbox" "$HOME/.local/bin/jetbrains-toolbox"
      setsid "$TBX_HOME/bin/jetbrains-toolbox" >/dev/null 2>&1 </dev/null &
      say "JetBrains Toolbox launched; complete sign-in from its window (Super+D → JetBrains Toolbox)."
    else
      warn "JetBrains Toolbox binary not found after extract"
    fi
  else
    warn "JetBrains Toolbox download failed"
  fi
  rm -rf "$tmp"
fi

# Discord is NOT installed here any more — it is a system flatpak (recipe.yml).
#
# It used to be a native tarball in $HOME because zypak broke the Wayland
# splash->main-window handoff under niri. Retested 2026-08-08: that bug is gone,
# the flatpak maps a normal main window, so the native install lost its only
# justification while keeping three real costs — no sandbox whatsoever, a
# self-updater that downloaded and exec'd a client into ~/.config/discord with no
# signature check, and an RPC listener on 127.0.0.1:6463 open to any local
# process.
#
# Removing the leftovers from a machine that ran the old path is a one-time
# manual step (SETUP §6); doing it automatically here would delete a running
# app's data out from under the user.

# --- 4. voice toolbox ----------------------------------------------------------
# Provision the `voice` toolbox behind the voice tooling (Mod+T dictation,
# Mod+Shift+T niri command mode): whisper.cpp + vosk and their models, built in a
# container so the heavy STT engines stay out of the image (only wtype is baked).
# voice-setup is a stowed dotfiles script (bin package, linked in step 2) and is
# idempotent. Non-fatal and referenced by absolute path (it may not be on PATH
# yet): it needs network and compiles whisper.cpp (a few minutes), so a failure
# here must not block the rest of bootstrap — just re-run voice-setup.
VOICE_SETUP="$HOME/.local/bin/voice-setup"
if [[ -x "$VOICE_SETUP" ]]; then
  say "provisioning the voice toolbox (whisper.cpp + vosk; builds in a container, may take a few minutes)"
  "$VOICE_SETUP" || warn "voice-setup failed (network? build?) — re-run later: voice-setup"
else
  warn "voice-setup not found (dotfiles not stowed?); skipping voice toolbox"
fi

# --- 5. login shell ------------------------------------------------------------
# The dotfiles target zsh (.zshrc). Make it the login shell so a fresh user lands
# in zsh — and thus brew + plugins — without a manual chsh. `sudo chsh` lets root
# change the shell without prompting for the account password via PAM; sudo was
# primed above by the brew step, and we re-prime defensively in case brew was
# already installed and that path got skipped. zsh's RPM registers /usr/bin/zsh in
# /etc/shells, so chsh accepts it.
if command -v zsh >/dev/null; then
  zsh_path="$(command -v zsh)"
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"
  if [[ "$current_shell" != "$zsh_path" ]]; then
    say "setting login shell to zsh"
    # A && B || C here is intentional (not if-then-else): whether `sudo -v` fails OR
    # `chsh` fails, we want the same warn — so the shellcheck SC2015 shape is benign.
    sudo -v && sudo chsh -s "$zsh_path" "$USER" \
      || warn "could not set login shell to zsh; run manually: chsh -s $zsh_path"
  fi
else
  warn "zsh not installed; leaving login shell unchanged"
fi

# --- 6. desktop appearance -----------------------------------------------------
# Global dark mode. niri has no settings daemon (unlike GNOME/KDE), so nothing
# sets the XDG desktop-portal color-scheme for us — yet GTK4/libadwaita, Firefox,
# Electron and portal-aware Qt apps all read `prefer-dark` from it. gtk-theme
# additionally covers older GTK3 apps that theme directly instead of via the
# portal. This is a per-user dconf setting (lives in $HOME), so it can't be baked
# into the image; apply it here. Idempotent — re-running just re-sets the value.
if command -v gsettings >/dev/null; then
  say "setting global dark mode (portal color-scheme + GTK theme)"
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark || warn "could not set color-scheme (no dbus session? run inside the niri session)"
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark    || warn "could not set gtk-theme"
fi

# VS Code's secret storage. Electron picks the keyring backend from
# XDG_CURRENT_DESKTOP, and `niri` is not a value it recognises, so VS Code reports
# "An OS keyring couldn't be identified" and offers a weaker built-in encryption
# instead (2026-10-11), even with gnome-keyring running and unlocked. Point it at the
# Secret Service in ~/.vscode/argv.json, the file VS Code reads its permanent flags
# from. That file is JSON with comments and VS Code edits it itself (it writes a
# per-machine crash-reporter-id), so it is patched in place rather than stowed,
# and only when the key is absent.
argv="$HOME/.vscode/argv.json"
if command -v code >/dev/null && ! grep -q '"password-store"' "$argv" 2>/dev/null; then
  say "pointing VS Code at the Secret Service keyring (~/.vscode/argv.json)"
  mkdir -p "$HOME/.vscode"
  [[ -s "$argv" ]] || printf '{\n}\n' > "$argv"
  /usr/bin/python3 - "$argv" <<'PY' || warn "could not patch $argv; add \"password-store\": \"gnome-libsecret\" by hand"
import re, sys
p = sys.argv[1]
s = open(p).read()
# Blank out comments (same length, so offsets still line up), leaving strings
# alone so a "//" inside a value is not mistaken for one.
mask = re.sub(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/',
              lambda m: m.group() if m.group()[0] == '"' else " " * len(m.group()),
              s, flags=re.S)
i = mask.index("{")
more = mask[i + 1:mask.rindex("}")].strip() != ""
# First member, so the comma (if any) follows our own value: valid with or
# without existing members, and no need to find the end of the last one.
member = '\n\t"password-store": "gnome-libsecret"' + ("," if more else "") + "\n"
open(p, "w").write(s[:i + 1] + member + s[i + 1:])
PY
fi

# Obsidian's secret storage: the same Electron problem as VS Code above, in the
# flatpak. With `niri` unrecognised it keeps its secrets in plaintext and says so
# on every start ("Secrets are stored without encryption because no secret store
# is available on this system", 2026-11-08), although gnome-keyring is running and
# owns org.freedesktop.secrets, and the flatpak already has talk access to it
# (org.freedesktop.secrets=talk in its manifest) — the backend is simply never
# asked for. The Flathub launcher reads permanent flags one per line from a
# user-flags file in the sandbox's XDG_CONFIG_HOME, which is this path on the host.
# Written even when the flatpak is not installed yet: at first boot the system
# flatpaks are still being pulled, and the point is to beat Obsidian's first run.
obsidian_flags="$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/user-flags.conf"
if ! grep -q '^--password-store=' "$obsidian_flags" 2>/dev/null; then
  say "pointing Obsidian at the Secret Service keyring (user-flags.conf)"
  mkdir -p "${obsidian_flags%/*}"
  echo '--password-store=gnome-libsecret' >> "$obsidian_flags" \
    || warn "could not write $obsidian_flags; add --password-store=gnome-libsecret by hand"
fi

# --- 7. $HOME convenience links ------------------------------------------------
# ~/Nextcloud -> the sync folder on the data drive. The Nextcloud client syncs into
# /var/mnt/data/nextcloud (the 1TB expansion card), not $HOME, so this is just a
# short path to it, sitting beside OneDrive-InstrumentalID and the XDG dirs.
#
# Points at /var/mnt/data/... deliberately rather than /mnt/data/...: /mnt is itself
# a symlink to var/mnt, and a symlink-through-a-symlink resolves inconsistently
# across tools.
#
# Created even when the drive is not mounted, which it usually will not be on a
# fresh install. A dangling link is the RIGHT failure mode here: it heals by itself
# once the volume mounts, and until then anything following it gets a clear ENOENT
# instead of silently seeing an empty directory — which is precisely the state that
# nearly had the Nextcloud client propagate local deletions to the server (SETUP §6).
nc_target="/var/mnt/data/nextcloud"
nc_link="$HOME/Nextcloud"
if [[ -L "$nc_link" ]]; then
  nc_current="$(readlink "$nc_link")"
  [[ "$nc_current" == "$nc_target" ]] \
    || warn "$nc_link already points at $nc_current, not $nc_target — leaving it alone"
elif [[ -e "$nc_link" ]]; then
  warn "$nc_link exists and is not a symlink — refusing to replace it"
else
  say "linking $nc_link -> $nc_target"
  ln -s "$nc_target" "$nc_link" || warn "could not create $nc_link"
  [[ -e "$nc_target" ]] \
    || warn "  target not present yet (data drive unmounted) — the link resolves once it is"
fi

# --- 8. user timers ------------------------------------------------------------
# Stowing a .timer only puts the unit in place; something still has to enable it.
# That intent lives here rather than as a committed timers.target.wants/ symlink
# in the dotfiles: systemd owns that directory and rewrites it behind your back
# (a `disable` shows up as a repo deletion), and the links it writes hardcode an
# absolute $HOME path that only resolves for one username.
#
# Only units that are enabled deliberately belong here. rclone-onedrive-iid,
# rclone-nextcloud, flipper-health.timer and flipper-mount.path are left
# disabled on purpose, and swayidle/graphical-session-bind/nextcloud-client/
# desktop-appearance/private-history are static — no [Install] section, pulled
# in by the units that need them.
#
# davmail and nntps-es were MISSING from this list until 2026-11-11, and the
# gitignore line above is exactly why that went unnoticed: both were enabled on
# the live machine, so `systemctl --user list-unit-files` looked right, but the
# enablement lived only in the untracked default.target.wants/ and would not
# survive a wipe. The mail chain would then come back half-wired — units stowed,
# nothing starting them, mbsync reading a Maildir that nobody was filling.
#
# Note what does NOT need a line here: davmail-codewatch.service and
# rigctld.service are pulled in by .wants/ directories that ARE tracked
# (davmail.service.wants/ and a dev-serial-…device.wants/), because the
# gitignore only excludes *.target.wants/.
#
# Idempotent: enabling an already-enabled unit is a no-op.
if systemctl --user show-environment >/dev/null 2>&1; then
  say "enabling user timers"
  systemctl --user daemon-reload || warn "daemon-reload failed; unit files may be stale"
  for unit in kb3lyb-backup.timer kb3lyb-backup-age.timer kb3lyb-doctor.timer davmail.service nntps-es.service; do
    if systemctl --user enable --now "$unit" >/dev/null 2>&1; then
      echo "    enabled $unit"
    else
      warn "could not enable $unit (is it stowed into $HOME/.config/systemd/user?)"
    fi
  done
else
  warn "no user systemd session; skipping timer enable (re-run this from a desktop login)"
fi

say "bootstrap complete. Open a new shell (zsh) to pick up the environment."
