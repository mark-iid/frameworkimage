#!/usr/bin/env bash
# kb3lyb-usb-retrain — force the Framework Expansion Card to retrain its USB link
# at SuperSpeed when a warm reboot has left it on the USB 2.0 companion port.
# Runs as root, once, EARLY — before systemd-cryptsetup@data.service unlocks the
# volume and before var-mnt-data.mount mounts it.
#
# THE BUG THIS EXISTS FOR
#
# A warm reboot never drops VBUS to the expansion card. The card keeps its power
# and its USB3 PHY state while the xHCI controller re-initialises around it, the
# SuperSpeed link fails to retrain, and it falls back to the USB 2.0 companion —
# 480 Mb/s instead of 10 Gb/s, i.e. ~23 MB/s of real throughput through LUKS
# instead of several hundred. Measured over 24 boots on this machine:
#
#     cold boot (powered off):  8/8  trained SuperSpeed Plus Gen 2x1
#     warm reboot:             4/16  trained; the other 12 fell back to 480
#
# A physical unplug/replug also fixes it, which is the clue: the card needs a
# power cycle, and only a cold boot or a replug gives it one. Toggling the hub
# port's `disable` does the same thing in software.
#
# System Firmware 0.0.3.20 is current (fwupdmgr reports no update), so there is
# no BIOS fix to wait for.
#
# WHY IT IS SAFE TO YANK THE PORT HERE
#
# Because of WHEN it runs. The unit is ordered Before=systemd-cryptsetup@data
# .service, so at this point nothing has opened the LUKS volume and nothing has
# mounted it — there is no dm mapping and no filesystem to rip out from under.
# That ordering is the whole safety argument, and it is not optional: doing this
# to a mounted volume corrupts the ext4 journal (learned the hard way — a
# mid-session replug produced "JBD2: I/O error when updating journal superblock").
#
# As a second line of defence the script REFUSES to toggle if it finds any block
# device under the card that is mounted or has dm holders. If that guard ever
# fires, the unit ordering is wrong; fix the ordering rather than the guard.
#
# Never fails the boot. Every non-fatal path logs and exits 0, because a slow
# disk is much better than an unbootable machine.
set -u

VID=32ac                # Framework
PID=0005                # 1TB Expansion Card
MIN_SPEED=5000          # sysfs `speed` in Mb/s; anything less is a USB 2.0 fallback
WAIT_APPEAR=10          # how long to wait for the card to enumerate at all
WAIT_RETRAIN=15         # how long to wait for it to come back after the toggle

log() { echo "usb-retrain: $*"; }

# sysfs dir of the expansion card, if it is present at all
find_card() {
    local d
    for d in /sys/bus/usb/devices/*/; do
        [ -r "$d/idVendor" ] && [ -r "$d/idProduct" ] || continue
        [ "$(cat "$d/idVendor")"  = "$VID" ] || continue
        [ "$(cat "$d/idProduct")" = "$PID" ] || continue
        echo "${d%/}"
        return 0
    done
    return 1
}

speed_of() { cat "$1/speed" 2>/dev/null || echo 0; }

# The hub port that owns this device. Discovered by walking the port objects and
# comparing their `device` symlink against the card, NOT by parsing "1-1" into a
# path — so this keeps working if the card is moved to another bay.
find_port() {
    local dev=$1 target p
    target=$(readlink -f "$dev") || return 1
    for p in /sys/bus/usb/devices/*/usb*-port*/; do
        [ -e "$p/device" ] && [ -e "$p/disable" ] || continue
        [ "$(readlink -f "$p/device")" = "$target" ] || continue
        echo "${p%/}"
        return 0
    done
    return 1
}

# Refuse to touch the port if anything is already using storage behind the card.
# Belt and braces behind the unit ordering; see the header.
card_in_use() {
    local dev=$1 real blk name h
    # /sys/bus/usb/devices/<id> is a SYMLINK into /sys/devices/..., so this must
    # resolve it (and find must be told -L). Without both, find silently descends
    # into nothing, reports no block devices, and the guard passes when it should
    # refuse — which is precisely how it failed the first time it was tested.
    real=$(readlink -f "$dev") || return 1
    while IFS= read -r blk; do
        name=$(basename "$blk")
        # mounted directly (whole disk or any partition of it)
        if grep -qE "^/dev/${name}[0-9]* " /proc/mounts 2>/dev/null; then
            log "REFUSING to toggle: /dev/$name is mounted"
            return 0
        fi
        # claimed by device-mapper (this is the LUKS case) or md, on the disk
        # itself or on any of its partitions
        for h in "$blk"/holders/* "$blk"/"${name}"*/holders/*; do
            [ -e "$h" ] || continue
            log "REFUSING to toggle: /dev/$name is held by $(basename "$h")"
            return 0
        done
    done < <(find -L "$real" -maxdepth 8 -path '*/block/sd*' -prune 2>/dev/null)
    return 1
}

# --- wait for the card to show up at all -------------------------------------
card=''
for _ in $(seq $((WAIT_APPEAR * 4))); do
    if card=$(find_card); then break; fi
    sleep 0.25
done

if [ -z "$card" ]; then
    log "expansion card not present; nothing to do"
    exit 0
fi

speed=$(speed_of "$card")
log "found card at $(basename "$card"), link ${speed} Mb/s"

if [ "$speed" -ge "$MIN_SPEED" ] 2>/dev/null; then
    log "already SuperSpeed; no action (this is the normal cold-boot path)"
    exit 0
fi

if card_in_use "$card"; then
    log "link is ${speed} Mb/s but the device is in use — leaving it alone."
    log "this means the unit ran too late; check its ordering vs systemd-cryptsetup@data.service"
    exit 0
fi

port=$(find_port "$card") || {
    log "could not locate the hub port for $(basename "$card"); leaving link at ${speed} Mb/s"
    exit 0
}

# --- power-cycle the port -----------------------------------------------------
log "link is ${speed} Mb/s (USB 2.0 fallback); power-cycling $(basename "$port")"

if ! echo 1 > "$port/disable" 2>/dev/null; then
    log "could not write $port/disable; leaving link at ${speed} Mb/s"
    exit 0
fi
sleep 2
if ! echo 0 > "$port/disable" 2>/dev/null; then
    log "FAILED to re-enable $port — the card will be absent this boot!" >&2
    # One more try; leaving the port disabled is the worst outcome here.
    sleep 1
    echo 0 > "$port/disable" 2>/dev/null || true
fi

# --- wait for it to come back, possibly on the other (SuperSpeed) bus ---------
card=''
for _ in $(seq $((WAIT_RETRAIN * 4))); do
    if card=$(find_card); then
        speed=$(speed_of "$card")
        [ "$speed" -ge "$MIN_SPEED" ] 2>/dev/null && break
    fi
    sleep 0.25
done

if [ -z "$card" ]; then
    log "card did NOT return after the port toggle — this boot has no /var/mnt/data" >&2
    exit 0
fi

speed=$(speed_of "$card")
if [ "$speed" -ge "$MIN_SPEED" ] 2>/dev/null; then
    log "retrained: now at $(basename "$card"), ${speed} Mb/s"
else
    log "still ${speed} Mb/s after the toggle; giving up (boot continues, just slow)"
fi
exit 0
