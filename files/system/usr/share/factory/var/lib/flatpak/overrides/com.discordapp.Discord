[Context]
# Force native Wayland for sharp HiDPI, same as the other Electron apps
# (DESIGN §4). Discord returned to the flatpak on 2026-08-08 once the zypak
# splash->main-window bug under niri was retested and found fixed.
sockets=wayland;fallback-x11;

[Environment]
ELECTRON_OZONE_PLATFORM_HINT=auto
