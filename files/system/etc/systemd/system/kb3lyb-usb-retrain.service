[Unit]
Description=Retrain the Framework Expansion Card USB link to SuperSpeed
Documentation=file:/usr/bin/kb3lyb-usb-retrain
# A warm reboot leaves the card on the USB 2.0 companion port (480 Mb/s) roughly
# 3 boots in 4; a cold boot never does. See the script header for the data.
#
# ORDERING IS THE SAFETY MECHANISM, not a preference. This must run while the
# card is still untouched: after udev has enumerated it, but BEFORE the LUKS
# volume is opened or /var/mnt/data is mounted. Power-cycling the port under a
# mounted filesystem corrupts the ext4 journal.
#
# DefaultDependencies=no is required to get in front of cryptsetup at all — a
# normal service is implicitly After=sysinit.target, which is far too late.
DefaultDependencies=no
After=systemd-udevd.service systemd-udev-trigger.service
Wants=systemd-udev-trigger.service
Before=systemd-cryptsetup@data.service cryptsetup.target
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kb3lyb-usb-retrain
# Bounded so a wedged USB port cannot stall the boot indefinitely. The script's
# own waits (10s to appear + 2s toggle + 15s to return) fit inside this.
TimeoutStartSec=45s

[Install]
WantedBy=sysinit.target
