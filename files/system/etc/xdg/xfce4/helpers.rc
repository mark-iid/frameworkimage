#
# System defaults for Xfce's "preferred applications", read by exo.
#
# Only TerminalEmulator is set, deliberately. Each value here names a helper
# .desktop in /usr/share/xfce4/helpers, and the ONLY one this image ships is
# ghostty.desktop (see the note in that file for why xfce4-settings, which
# normally provides the whole set, is not installed).
#
# The stock helpers.rc also sets WebBrowser=firefox, MailReader=thunderbird and
# FileManager=thunar. Those are deliberately omitted rather than copied:
#   * firefox is a flatpak here, not a binary on $PATH (DESIGN §8.5)
#   * thunderbird is not installed at all — mail is Evolution
#   * thunar IS installed, but its helper definition is not, so naming it would
#     point at a file that does not exist
# Pointing any of them at a missing helper is worse than leaving them unset,
# which just lets exo fall through to the normal xdg-open/mimeapps path.
#
TerminalEmulator=ghostty
