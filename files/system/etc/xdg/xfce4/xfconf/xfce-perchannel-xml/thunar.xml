<?xml version="1.0" encoding="UTF-8"?>

<!--
  System default for the Thunar xfconf channel.

  Thunar 4.20 will not run an executable .sh from the file manager unless
  misc-exec-shell-scripts-by-default is true; unset defaults to false, so
  double-clicking a script that already has +x does nothing useful.

  xfconf reads channel defaults from $XDG_CONFIG_DIRS as well as
  $XDG_CONFIG_HOME, so dropping the channel XML here makes this the default for
  every account on the machine while a per-user
  ~/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml still wins if one exists.
  That ordering matters: this sets the default, it does not override a choice
  already made in the GUI.

  Note this only affects scripts that ALREADY carry the executable bit — it is
  not a blanket "run anything I click on". Thunar still refuses non-executable
  files, so the +x bit remains the thing that grants execution.
-->

<channel name="thunar" version="1.0">
  <property name="misc-exec-shell-scripts-by-default" type="bool" value="true"/>

  <!--
    Thumbnails off. Thunar is the only thing on this machine that asks for them,
    so NEVER means no thumbnail is requested and nothing is written to
    $XDG_CACHE_HOME/thumbnails or to a .sh_thumbnails/ directory beside the
    source files. files/system/etc/xdg/tumbler/tumbler.rc disables every
    thumbnailer plugin as the second half of this; either alone leaves a path
    open, because any other XDG thumbnail consumer would still trigger tumbler.
    NEVER does not stop Thunar from contacting tumbler: it still asks
    GetSupported at startup, which crashed the plugin-less tumblerd, so
    tumblerd.service is also masked in the recipe's systemd module.

    PER-USER FILE WINS, per the note above: an account whose
    ~/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml already carries
    misc-thumbnail-mode keeps its own value and ignores this. Changing it on a
    live machine is therefore a separate step:
      xfconf-query -c thunar -p /misc-thumbnail-mode -s THUNAR_THUMBNAIL_MODE_NEVER
    Values are NEVER / ONLY_LOCAL / ALWAYS; ONLY_LOCAL still caches, it just
    skips remote filesystems.
  -->
  <property name="misc-thumbnail-mode" type="string" value="THUNAR_THUMBNAIL_MODE_NEVER"/>
</channel>
