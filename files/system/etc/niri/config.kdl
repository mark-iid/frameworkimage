// kb3lyb-sway — baked niri default config.
//
// This lives at /etc/niri/config.kdl, niri's SYSTEM fallback. It is NOT in
// /etc/skel on purpose: skel copies into $HOME and would collide with the real
// config stow-deployed from the dotfiles repo (DESIGN §6). A system fallback
// gives a fresh user a working session while leaving $HOME empty for stow.
//
// Keep this minimal and "sane default". Real iteration happens in the dotfiles
// repo and takes effect on `niri msg action reload-config` (DESIGN §6 test).

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt   // disable-while-typing
    }
    focus-follows-mouse
}

output "eDP-1" {
    // Framework 13 2256x1504 ~200 DPI panel. 1.35 matches the current setup
    // (DESIGN §1/§2). Wayland-native apps render sharp at this fractional scale.
    scale 1.35
}

// HiDPI note (DESIGN §4): the compositor scale above handles native apps. The
// XWayland toolkit-scaling env vars (GDK_SCALE / QT_SCALE_FACTOR / Xft.dpi) are
// deliberately NOT set here — they are global and would double native GTK apps.
// Tune those per the operator's dotfiles via ~/.config/environment.d.

environment {
    // Force Electron/Chromium and Qt onto native Wayland where they honor it.
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    // XWayland via niri's xwayland-satellite integration.
    DISPLAY ":0"
}

prefer-no-csd

// Screenshots land here.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#505050"
    }
}

// Startup: bar, notifications, polkit agent, clipboard history, XWayland, and the
// network/bluetooth tray applets. waybar's tray module stays empty without an SNI
// provider running; `nm-applet --indicator` uses the StatusNotifierItem path that
// waybar understands (plain `nm-applet` would try the dead XEmbed tray instead).
spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"

cursor {
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Terminal, launcher, lock. Terminal is foot for now; ghostty (the intended
    // terminal, DESIGN §2) gets layered in once a COPR is vetted.
    Mod+Return  { spawn "foot"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+Escape  { spawn "gtklock"; }

    // Clipboard history picker.
    Mod+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    Mod+Q       { close-window; }

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }
    Mod+K       { focus-window-up; }
    Mod+J       { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Escape hatch for X11 apps that fullscreen themselves. SDL/Ren'Py games set
    // _NET_WM_STATE_FULLSCREEN on their own window and re-assert it, so the
    // fullscreen-window bind above flips niri's flag and the client stomps it back.
    // wmctrl clears the property on the X side instead. DISPLAY :0 comes from the
    // environment block above, so this reaches xwayland-satellite's server.
    Mod+Shift+X { spawn "wmctrl" "-r" ":ACTIVE:" "-b" "remove,fullscreen"; }

    // Screenshots.
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // Hardware keys (Framework 13). require: brightnessctl, playerctl, wpctl.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
