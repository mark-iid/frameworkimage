[Unit]
Description=Update system flatpaks
Wants=network-online.target
After=network-online.target
# Don't fight the first-boot flatpak install (default-flatpaks module).
After=flatpak-system-update.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak update --system --noninteractive --assumeyes
# NO SuccessExitStatus override. This used to carry `SuccessExitStatus=0 1` to
# keep an offline run from reporting failure — but `flatpak update` exits 1 for
# *both* "no network" and "the update actually failed", so that setting made the
# unit report success no matter what went wrong. A browser that quietly stopped
# receiving security updates would have shown green forever.
#
# The trade is accepted deliberately: on a laptop that is often off-network, an
# offline day now leaves the unit failed until the next successful run. That is
# mild noise, but it is *true* — it means the system flatpaks are not current,
# which is exactly what `systemctl --failed` should be telling you.
